# Image for apps/extraction-pipeline. The build context is that directory;
# build it through the Makefile next to this file:  make -C infra image
#
# The same image serves both roles: one-off runs under Apple `container` or
# Kata, and the base of the persistent Apple container machine (where the
# code comes from the host home mount instead of /app).
FROM registry.fedoraproject.org/fedora:44

# python3.12: the interpreter the pinned wheels were checked against.
# rsync: stage 0 snapshot shells out to `rsync -aAX`.
# systemd, sudo, shadow-utils: so the image can boot as an Apple container
# machine (init system, host-user creation, passwordless sudo).
RUN dnf -y install --setopt=install_weak_deps=False \
        python3.12 rsync systemd sudo shadow-utils \
 && dnf clean all

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt /tmp/requirements.txt
RUN python3.12 -m venv /opt/venv \
 && pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /app
COPY excludes.txt pipeline.py ./
COPY pipeline_lib/ pipeline_lib/
COPY tests/ tests/
COPY test_docs/ test_docs/

CMD ["python", "pipeline.py", "--help"]
